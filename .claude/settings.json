{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(reference.md)",
      "Write(reference.md)",
      "Edit(reference.pdf)",
      "Write(reference.pdf)"
    ],
    "allow": [
      "Bash(PYTHONIOENCODING=utf-8 python -)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Python314\\python.exe",
            "args": [
              "C:\\che_note\\.claude\\hooks\\protect_reference.py"
            ],
            "timeout": 10,
            "statusMessage": "检查 reference.md 保护"
          }
        ]
      }
    ]
  }
}
